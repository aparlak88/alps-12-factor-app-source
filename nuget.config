<?xml version="1.0" encoding="utf-8"?>
<!--
  12-Factor Principle: Factor II — Dependencies
  Explicitly declare and isolate dependencies.

  Why a repository-root nuget.config with <clear /> is required for Factor II:
  By default, NuGet merges configuration hierarchically from machine-wide and user-profile locations
  (e.g., ~/.nuget/NuGet/NuGet.Config or /Library/Application Support). If a developer's workstation
  has a local folder feed, a private corporate feed, or cached offline fallback sources configured globally,
  builds can silently resolve packages that do not exist in the canonical upstream source.

  Using <clear /> inside <packageSources> and <packageSourceMapping> wipes out all inherited machine-global
  feeds and restricts package resolution strictly to the explicitly declared official nuget.org V3 feed.
  This guarantees deterministic, reproducible dependency resolution across every developer machine,
  CI runner, and Docker build container.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
